 "cards": [
  {
   "key": "whats_going_on",
   "title": "What's going on",
   "text": "MPS IIIC happens because of changes in a gene called HGSNAT [E63cdaf8, E75a697a]. This gene is the instructions for making an enzyme, which is a helper protein, that normally breaks down a sugar-like substance called heparan sulfate [E5e16efb]. In MPS IIIC, this enzyme is missing or does not work the way it should [E108a4c3, Ec16062e]. In many children, the enzyme is made with the wrong shape, called misfolding, which can put stress on the inside of cells, something called ER stress [E39478ab, Ed45e10c]. Because the enzyme cannot do its job, heparan sulfate builds up inside tiny recycling bags inside cells called lysosomes [E7373ae4, Efdcc8cb]. This buildup is linked to the loss of nerve cells, called neurodegeneration [E6b41a5b]. There is also swelling and irritation around nerve cells, called neuroinflammation, and problems with how nerve cells connect and send signals to each other, called synaptic dysfunction [Ec731ac0, E2ed694d].",
   "citations": [
    "E63cdaf8",
    "E75a697a",
    "E5e16efb",
    "E108a4c3",
    "Ec16062e",
    "E39478ab",
    "Ed45e10c",
