+export async function draftOutreachEmail(diseaseId: string, sender: ApiSender, orgId?: string | null): Promise<ApiEmailResponse | null> {
+  if (!USE_API) { await pause(); return null; }
+  return atlasApi.email({ disease_id: diseaseId, sender, org_id: orgId ?? null });
+}
