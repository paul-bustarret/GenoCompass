+// Converts backend responses (src/lib/atlas-api.ts, docs/contract.md) into the UI's existing
+// record shapes (Node / Disease / Edge / Partner, inferred from src/data/*.json in src/lib/atlas.ts).
+// Pure functions only: no fetching, no caching.
+
+import type { Disease, Edge, Node, Partner } from "@/lib/atlas";
+import type {
+  ApiCard,
+  ApiContext,
+  ApiEdge,
+  ApiEvidence,
+  ApiJourneyResponse,
+  ApiNode,
+  ApiOrganization,
+  ApiSearchMatch,
+  ApiSimilar,
+  ApiSubgraphResponse,
+} from "@/lib/atlas-api";
+
+/** UI edge plus optional backend-only fields (extra keys are ignored by existing components). */
+export type UiEdge = Edge & {
+  source_url?: string | null;
+  quote?: string | null;
+  /** Backend edge ids that support a computed similarity edge (open with getEvidence). */
+  evidence_edges?: string[];
+  gene_score?: number;
+};
+
+// ---------------------------------------------------------------------------
+// Small helpers
+// ---------------------------------------------------------------------------
+
+/** Removes `[E1a2b3c4]` and `[Eae05983, Ebfd4d0a]` citation markers and tidies whitespace. */
+export function stripCitations(text: string): string {
+  return text
+    .replace(/\s*\[E[0-9a-f]+(?:\s*,\s*E[0-9a-f]+)*\]/gi, "")
+    .replace(/\s+([.,;:!?])/g, "$1")
+    .replace(/\s{2,}/g, " ")
+    .trim();
+}
+
+/** Extracts the cited edge ids from a text with `[E…]` markers, in order of first appearance. */
+export function citationIds(text: string): string[] {
+  const ids: string[] = [];
+  for (const m of text.matchAll(/\[(E[0-9a-f]+(?:\s*,\s*E[0-9a-f]+)*)\]/gi)) {
+    for (const id of (m[1] ?? "").split(/\s*,\s*/)) if (id && !ids.includes(id)) ids.push(id);
+  }
+  return ids;
+}
+
+export const slug = (s: string) =>
+  s
+    .toLowerCase()
+    .normalize("NFKD")
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "") || "group";
+
+const humanize = (s: string) => {
+  const t = s.replace(/_/g, " ");
+  return t.charAt(0).toUpperCase() + t.slice(1);
+};
+
+let regionNames: Intl.DisplayNames | null | undefined;
+/** ISO-3166 alpha-2 → country name ("GB" → "United Kingdom"); falls back to the code. */
+export function countryName(code: string | null | undefined): string {
+  if (!code) return "Region not listed";
+  if (regionNames === undefined) {
+    try {
+      regionNames = new Intl.DisplayNames(["en"], { type: "region" });
+    } catch {
+      regionNames = null;
+    }
+  }
+  try {
+    return regionNames?.of(code.toUpperCase()) ?? code;
+  } catch {
+    return code;
+  }
+}
+
+const RELATION_LABELS: Record<string, string> = {
+  caused_by: "Caused by gene",
+  has_phenotype: "Has symptom",
+  has_variant: "Has variant",
+  pathogenic_for: "Disease-causing variant",
+  in_pathway: "Part of pathway",
+  part_of: "Part of pathway",
+  has_mechanism: "Shared mechanism",
+  studied_with: "Studied with",
+  studies: "Works on",
+  runs: "Runs",
+  tests: "Tests",
+  pi_of: "Leads grant",
+  funds: "Funds",
+  mentions: "Mentioned in paper",
+  authored: "Authored",
+  has_site_in: "Trial site in",
+  based_in: "Based in",
+};
+export const relationLabel = (relation: string) => RELATION_LABELS[relation] ?? humanize(relation);
+
+// ---------------------------------------------------------------------------
+// Research activity (0–100)
+// ---------------------------------------------------------------------------
+
+/**
+ * 0–100 score from the number of trials, grants and papers in the disease's subgraph.
+ * Saturating curve: 0 → 0, 10 → ~49, 20 → ~74, 40 → ~93, ≥60 → ~98.
+ */
+export function researchActivity(
+  subgraph: Pick<ApiSubgraphResponse, "nodes"> | null | undefined,
+): number {
+  if (!subgraph) return 0;
+  const n = subgraph.nodes.filter(
+    (x) => x.type === "trial" || x.type === "grant" || x.type === "paper",
+  ).length;
+  return Math.round(100 * (1 - Math.exp(-n / 15)));
+}
+
+// ---------------------------------------------------------------------------
+// Disease / cluster nodes
+// ---------------------------------------------------------------------------
+
+export function clusterIdFor(
+  node: Pick<ApiNode, "attrs"> | null | undefined,
+  clusterId?: number | string | null,
+): string {
+  const group = node?.attrs.group;
+  if (typeof group === "string" && group) return slug(group);
+  if (clusterId !== undefined && clusterId !== null) return `cluster-${clusterId}`;
+  return "unmapped";
+}
+
+/** Builds a UI cluster node for a backend display group (attrs.group) or numeric cluster id. */
+export function toUiCluster(id: string, label?: string | null): Node {
+  const name = label ?? (id === "unmapped" ? "Not yet grouped" : humanize(id.replace(/-/g, " ")));
+  return {
+    id,
+    type: "cluster",
+    label: name,
+    plain_label: name,
+    synonyms: [],
+    xrefs: {},
+    cluster: null,
+    research_activity: 0,
+    attributes: { color_token: "teal" },
+  };
+}
+
+function whatsGoingOn(cards: ApiCard[] | undefined): string | null {
+  const card = cards?.find((c) => c.key === "whats_going_on" && c.status === "ok");
+  return card ? stripCitations(card.text) : null;
+}
+
+export interface ToUiDiseaseInput {
+  /** The disease node (from /node/{id} or the subgraph's anchor). */
+  node?: ApiNode | null;
+  /** /journey or /recommend response for this disease. */
+  journey?: ApiJourneyResponse | null;
+  /** /subgraph response anchored on this disease (used for research_activity). */
+  subgraph?: ApiSubgraphResponse | null;
+  /** Fallback when only an id/name is known (e.g. a search match or a similar[] entry). */
+  fallback?: { id: string; name: string; short?: string | null };
+  clusterId?: number | string | null;
+  patientGroup?: string;
+  /** Gene override (e.g. from a neighbour's caused_by edge in another disease's subgraph). */
+  gene?: string;
+}
+
+/**
+ * label ← short || name · plain_label ← name · synonyms · xrefs.OMIM ← attrs.omim ·
+ * cluster ← attrs.group (slug) or cluster id · attributes.gene ← profile.genes[0] ·
+ * attributes.description ← whats_going_on card (citations stripped), else attrs.description, else "" ·
+ * research_activity ← trials+grants+papers in the subgraph.
+ */
+export function toUiDisease(input: ToUiDiseaseInput): Disease {
+  const { journey, subgraph, fallback } = input;
+  const id = input.node?.id ?? journey?.disease.id ?? subgraph?.anchor ?? fallback?.id ?? "";
+  const node = input.node ?? subgraph?.nodes.find((n) => n.id === id) ?? null;
+  const name = node?.name ?? journey?.disease.name ?? fallback?.name ?? id;
+  const shortName =
+    (typeof node?.attrs.short === "string" && node.attrs.short) ||
+    journey?.disease.short ||
+    fallback?.short ||
+    null;
+  const omim = typeof node?.attrs.omim === "string" ? node.attrs.omim.replace(/^OMIM:/, "") : null;
+  const gene =
+    (input.gene || journey?.profile.genes[0]?.name) ??
+    subgraph?.nodes.find(
+      (n) =>
+        n.type === "gene" &&
+        subgraph.edges.some(
+          (e) => e.source === id && e.target === n.id && e.relation === "caused_by",
+        ),
+    )?.name ??
+    "";
+  const description =
+    whatsGoingOn(journey?.cards) ??
+    (typeof node?.attrs.description === "string" ? node.attrs.description : null) ??
+    "";
+  const patientGroup =
+    input.patientGroup ??
+    journey?.organizations
+      .filter((o) => o.for_disease === id && o.kind === "patient_group")
+      .map((o) => o.name)[0] ??
+    "";
+  const disease: Disease = {
+    id,
+    type: "disease",
+    label: shortName || name,
+    plain_label: name,
+    synonyms: node?.synonyms ?? [],
+    xrefs: { OMIM: omim ?? "" },
+    cluster: clusterIdFor(node, input.clusterId),
+    research_activity: researchActivity(subgraph),
+    attributes: { gene, description, patient_group: patientGroup },
+  };
+  return disease;
+}
+
+/** Minimal disease record for a search hit (enriched later by getDiseaseProfile / getGraph). */
+export function searchMatchToUiDisease(match: ApiSearchMatch, node?: ApiNode | null): Disease {
+  return toUiDisease({ node: node ?? null, fallback: { id: match.id, name: match.name } });
+}
+
+// ---------------------------------------------------------------------------
+// Evidence edges
+// ---------------------------------------------------------------------------
+
+/** observed → curated · extracted → extracted · inferred → inferred */
+export function toUiEvidenceType(evidence: ApiEvidence): "curated" | "extracted" | "inferred" {
+  return evidence === "observed" ? "curated" : evidence === "extracted" ? "extracted" : "inferred";
+}
+
+/**
+ * context → evidence_level (UI: hypothesis | preclinical | clinical_observation | clinical_trial):
+ * trial-derived relations → clinical_trial · human/review → clinical_observation ·
+ * animal_model/cell_model → preclinical · null → clinical_observation for observed database records,
+ * hypothesis otherwise.
+ */
+export function toUiEvidenceLevel(
+  edge: Pick<ApiEdge, "context" | "evidence" | "relation" | "source_name" | "source">,
+): string {
+  if (
+    /clinicaltrials/i.test(edge.source_name) ||
+    edge.relation === "tests" ||
+    edge.relation === "has_site_in" ||
+    edge.source.startsWith("NCT")
+  )
+    return "clinical_trial";
+  const ctx: ApiContext | null = edge.context;
+  if (ctx === "human" || ctx === "review") return "clinical_observation";
+  if (ctx === "animal_model" || ctx === "cell_model") return "preclinical";
+  return edge.evidence === "observed" ? "clinical_observation" : "hypothesis";
+}
+
+/**
+ * One backend edge → UI evidence record. quote → plain_explanation; polarity "contradicts" → negated;
+ * contradicted_by ← ids of `contradicts` edges between the same endpoints found in `pool`.
+ */
+export function toUiEvidence(
+  edge: ApiEdge,
+  pool: ApiEdge[] = [],
+  nodeName?: (id: string) => string | undefined,
+): UiEdge {
+  const label = relationLabel(edge.relation);
+  const fallbackText = `${nodeName?.(edge.source) ?? edge.source} — ${label.toLowerCase()} — ${nodeName?.(edge.target) ?? edge.target} (${edge.source_name} record).`;
+  const contradictedBy =
+    edge.polarity === "supports"
+      ? pool
+          .filter(
+            (o) =>
+              o.id !== edge.id &&
+              o.polarity === "contradicts" &&
+              o.relation === edge.relation &&
+              ((o.source === edge.source && o.target === edge.target) ||
+                (o.source === edge.target && o.target === edge.source)),
+          )
+          .map((o) => o.id)
+      : [];
+  return {
+    id: edge.id,
+    source: edge.source,
+    target: edge.target,
+    type: edge.relation,
+    plain_explanation: edge.quote ? `“${edge.quote}”` : fallbackText,
+    evidence_type: toUiEvidenceType(edge.evidence),
+    evidence_level: toUiEvidenceLevel(edge),
+    source_name: edge.source_name,
+    source_id: edge.source_url ?? edge.id,
+    retrieved_at: edge.retrieved_at ?? "",
+    confidence: edge.confidence,
+    negated: edge.polarity === "contradicts",
+    contradicted_by: contradictedBy,
+    score: edge.confidence,
+    mechanism_score: 0,
+    pathway_score: 0,
+    phenotype_score: 0,
+    effect_compatible: edge.polarity !== "contradicts",
+    witnesses: [edge.source, edge.target],
+    relationship_label: label,
+    source_url: edge.source_url,
+    quote: edge.quote,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Similarity edges (journey.similar[] / lookalikes[])
+// ---------------------------------------------------------------------------
+
+const KIND_LABEL: Record<string, string> = {
+  mechanism: "mechanism",
+  pathway: "pathway",
+  gene: "gene",
+  phenotype: "symptom",
+};
+
+/**
+ * journey.similar[] (+ lookalikes[]) → UI `similar_to` edges anchored on journey.disease.id.
+ * score/components/witnesses carried over; lookalike → negated (UI "Caution"), effect_compatible false.
+ * evidence_type is the strongest evidence among the witness edges found in `subgraph` (observed →
+ * curated), else "inferred" (similarity is computed by the atlas).
+ */
+export function toUiSimilarEdges(
+  journey: ApiJourneyResponse,
+  subgraph?: ApiSubgraphResponse | null,
+): UiEdge[] {
+  const anchor = journey.disease.id;
+  const byId = new Map((subgraph?.edges ?? []).map((e) => [e.id, e]));
+  const seen = new Set<string>();
+  const entries = [
+    ...journey.similar,
+    ...journey.lookalikes.map((s) => ({ ...s, lookalike: true })),
+  ];
+  const out: UiEdge[] = [];
+  for (const s of entries) {
+    if (seen.has(s.id) || s.id === anchor) continue;
+    seen.add(s.id);
+    out.push(similarToUiEdge(anchor, journey.disease.short ?? journey.disease.name, s, byId));
+  }
+  return out;
+}
+
+function similarToUiEdge(
+  anchor: string,
+  anchorName: string,
+  s: ApiSimilar,
+  byId: Map<string, ApiEdge>,
+): UiEdge {
+  const evidenceIds = [...new Set(s.witnesses.flatMap((w) => w.edges))];
+  const evidence = evidenceIds.map((id) => byId.get(id)).filter((e): e is ApiEdge => Boolean(e));
+  const evidenceType: UiEdge["evidence_type"] = s.lookalike
+    ? "inferred"
+    : evidence.some((e) => e.evidence === "observed")
+      ? "curated"
+      : evidence.some((e) => e.evidence === "extracted")
+        ? "extracted"
+        : "inferred";
+  const levels = evidence.map(toUiEvidenceLevel);
+  const evidenceLevel = s.lookalike
+    ? "hypothesis"
+    : levels.includes("clinical_trial")
+      ? "clinical_trial"
+      : levels.includes("clinical_observation")
+        ? "clinical_observation"
+        : levels.includes("preclinical")
+          ? "preclinical"
+          : "hypothesis";
+  const top = s.witnesses[0];
+  const relationship = s.lookalike
+    ? "Symptom overlap only"
+    : top
+      ? `Shared ${KIND_LABEL[top.kind] ?? top.kind}: ${top.name}`
+      : "Computed similarity";
+  const names = s.witnesses.slice(0, 3).map((w) => `${w.name} (${KIND_LABEL[w.kind] ?? w.kind})`);
+  const explanation = s.lookalike
+    ? `${anchorName} and ${s.name} share some symptoms, but the underlying mechanism differs; treatments may not transfer.`
+    : names.length
+      ? `${anchorName} and ${s.name} are both linked to ${names.join(", ")}${s.witnesses.length > 3 ? ` and ${s.witnesses.length - 3} more` : ""}.`
+      : `${anchorName} and ${s.name} have a computed similarity score of ${s.score.toFixed(2)}.`;
+  const firstSourced = evidence.find((e) => e.source_url);
+  const retrieved =
+    evidence
+      .map((e) => e.retrieved_at)
+      .filter((d): d is string => Boolean(d))
+      .sort()
+      .at(-1) ?? "";
+  return {
+    id: `sim:${anchor}:${s.id}`,
+    source: anchor,
+    target: s.id,
+    type: "similar_to",
+    plain_explanation: explanation,
+    evidence_type: evidenceType,
+    evidence_level: evidenceLevel,
+    source_name: `Atlas similarity (computed from ${evidenceIds.length} sourced edge${evidenceIds.length === 1 ? "" : "s"})`,
+    source_id: evidenceIds[0] ?? "—",
+    retrieved_at: retrieved,
+    confidence: s.score,
+    negated: s.lookalike,
+    contradicted_by: [],
+    score: s.score,
+    mechanism_score: s.components.mechanism,
+    pathway_score: s.components.pathway,
+    phenotype_score: s.components.phenotype,
+    gene_score: s.components.gene,
+    effect_compatible: !s.lookalike,
+    witnesses: s.witnesses.map((w) => w.id),
+    relationship_label: relationship,
+    source_url: firstSourced?.source_url ?? null,
+    evidence_edges: evidenceIds,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Partners (journey.organizations)
+// ---------------------------------------------------------------------------
+
+const ORG_KIND_LABEL: Record<string, string> = {
+  patient_group: "Patient group",
+  sponsor: "Trial sponsor",
+  funder: "Funder",
+  company: "Company",
+  industry: "Company",
+  academic: "Academic group",
+  registry_host: "Registry host",
+  nih: "NIH institute",
+  other: "Organization",
+};
+
+/**
+ * journey.organizations[] → Partner. region ← country (name) · email ← contact_email ("" when missing) ·
+ * sourceUrl ← website, else the first cited edge's source_url · contactSourceUrl ← cited edge source_url.
+ * `edgesById` should hold the org's cited edges (from the subgraph or /edge lookups).
+ */
+export function toPartner(
+  org: ApiOrganization,
+  opts: { diseaseName?: string; edgesById?: Map<string, ApiEdge> } = {},
+): Partner {
+  const cited = org.edges
+    .map((id) => opts.edgesById?.get(id))
+    .filter((e): e is ApiEdge => Boolean(e));
+  const sourced = cited.find((e) => e.source_url);
+  const withQuote =
+    cited.find((e) => e.quote && e.relation === "studies") ?? cited.find((e) => e.quote);
+  const kind = ORG_KIND_LABEL[org.kind ?? ""] ?? (org.kind ? humanize(org.kind) : "Organization");
+  const disease = opts.diseaseName ?? "this condition";
+  const sourceUrl = org.website ?? sourced?.source_url ?? "";
+  return {
+    id: org.id,
+    diseaseId: org.for_disease,
+    name: org.name,
+    kind,
+    region: countryName(org.country),
+    contactName: org.contact_email ? "General contact" : "No public contact email",
+    email: org.contact_email ?? "",
+    approach: withQuote?.quote
+      ? stripCitations(withQuote.quote)
+      : `${kind} linked to ${disease} in the atlas.`,
+    stage:
+      org.kind === "patient_group"
+        ? "Community / patient organization"
+        : "Research or development stage not recorded",
+    sourceLabel: org.website
+      ? "Organization website"
+      : sourced
+        ? `${sourced.source_name} source`
+        : "Atlas record",
+    sourceUrl,
+    contactSourceUrl: sourced?.source_url ?? sourceUrl,
+    question: `Could you share what your organization is currently doing for people with ${disease}, and how families or researchers can connect with that work?`,
+  };
+}
