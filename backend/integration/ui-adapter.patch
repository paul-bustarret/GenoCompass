+// Typed client for the Rare Disease Atlas backend (FastAPI, `python -m atlas.server`).
+// Shapes mirror rare_disease_atlas/docs/contract.md (§1 graph records, §3 responses).
+// Route components never import this file directly; they go through src/lib/atlas.ts.
+
+const env = import.meta.env as Record<string, string | undefined>;
+
+export const ATLAS_API_URL: string = (env["VITE_ATLAS_API_URL"] || "http://localhost:8000").replace(
+  /\/+$/,
+  "",
+);
+
+/** Default timeout for deterministic endpoints (search, subgraph, journey, node, edge, health). */
+export const DEFAULT_TIMEOUT_MS = 20_000;
+/** LLM-backed endpoints (recommend, email, chat, documents) can take much longer on a cold cache. */
+export const LLM_TIMEOUT_MS = 120_000;
+
+// ---------------------------------------------------------------------------
+// §1 Graph records
+// ---------------------------------------------------------------------------
+
+export type ApiNodeType =
+  | "disease"
+  | "gene"
+  | "variant"
+  | "phenotype"
+  | "pathway"
+  | "mechanism"
+  | "paper"
+  | "trial"
+  | "intervention"
+  | "grant"
+  | "person"
+  | "organization"
+  | "asset"
+  | "country";
+
+export type ApiDiseaseRole = "hero" | "lysosomal" | "bridge" | "lookalike";
+
+/** `attrs` differs by node type; every field is optional and may be null. */
+export interface ApiNodeAttrs {
+  // disease
+  short?: string | null;
+  omim?: string | null;
+  role?: ApiDiseaseRole | string | null;
+  group?: string | null;
+  description?: string | null;
+  mondo_label?: string | null;
+  // gene
+  hgnc?: string | null;
+  uniprot?: string | null;
+  // variant
+  significance?: string | null;
+  consequence?: string | null;
+  // mechanism
+  label?: string | null;
+  // paper
+  journal?: string | null;
+  pubdate?: string | null;
+  authors?: string | string[] | null;
+  // trial
+  status?: string | null;
+  phase?: string | null;
+  countries?: string[] | string | null;
+  // intervention / organization / asset
+  kind?: string | null;
+  // grant
+  fiscal_year?: number | string | null;
+  org?: string | null;
+  // person
+  first?: string | null;
+  last?: string | null;
+  // organization / asset
+  website?: string | null;
+  contact_email?: string | null;
+  country?: string | null;
+  // country
+  name?: string | null;
+  [key: string]: unknown;
+}
+
+export interface ApiNode {
+  id: string;
+  type: ApiNodeType | string;
+  name: string;
+  synonyms: string[];
+  attrs: ApiNodeAttrs;
+}
+
+export type ApiRelation =
+  | "caused_by"
+  | "has_phenotype"
+  | "has_variant"
+  | "pathogenic_for"
+  | "in_pathway"
+  | "part_of"
+  | "has_mechanism"
+  | "studied_with"
+  | "studies"
+  | "runs"
+  | "tests"
+  | "pi_of"
+  | "funds"
+  | "mentions"
+  | "authored"
+  | "has_site_in"
+  | "based_in";
+
+export type ApiEvidence = "observed" | "extracted" | "inferred";
+export type ApiPolarity = "supports" | "contradicts";
+export type ApiEffect = "LoF" | "GoF" | "dominant_negative";
+export type ApiContext = "human" | "animal_model" | "cell_model" | "review";
+
+export interface ApiEdge {
+  id: string;
+  source: string;
+  target: string;
+  relation: ApiRelation | string;
+  evidence: ApiEvidence;
+  confidence: number;
+  polarity: ApiPolarity;
+  effect: ApiEffect | null;
+  source_name: string;
+  source_url: string | null;
+  quote: string | null;
+  frequency: string | null;
+  context: ApiContext | null;
+  retrieved_at: string | null;
+  submitted_by: string | null;
+}
+
+// ---------------------------------------------------------------------------
+// §3 Response shapes
+// ---------------------------------------------------------------------------
+
+export interface ApiSearchMatch {
+  id: string;
+  type: ApiNodeType | string;
+  name: string;
+  score: number;
+  matched_on: string;
+}
+
+export interface ApiSearchResponse {
+  query: string;
+  status: "ok" | "ambiguous" | "not_found";
