+/** Stateless grounded chat (POST /chat). Answers carry `[E…]` citations; resolve them with getEvidence. */
+export async function askAtlas(diseaseId: string, messages: ApiChatMessage[]): Promise<ApiChatResponse> {
+  if (USE_API) return atlasApi.chat({ disease_id: diseaseId, messages });
+  await pause();
+  return { answer: "The live atlas API is not connected in this demo (set VITE_ATLAS_API_URL).", citations: [], grounded: false, out_of_scope: true };
+}
