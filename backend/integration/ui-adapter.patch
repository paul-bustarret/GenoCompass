+
+// ---------------------------------------------------------------------------
+// API implementations (only used when USE_API)
+// ---------------------------------------------------------------------------
+
+function upsert<T extends { id: string }>(list: T[], item: T, merge?: (prev: T, next: T) => T) {
+  const i = list.findIndex((x) => x.id === item.id);
+  if (i < 0) list.push(item);
+  else { const prev = list[i]; list[i] = prev && merge ? merge(prev, item) : item; }
+}
+
+/** Keeps the richer value for each field, so a sparse search hit never erases a full profile. */
+function mergeDisease(prev: Disease, next: Disease): Disease {
+  return {
+    id: next.id,
+    type: "disease",
+    label: next.label || prev.label,
+    plain_label: next.plain_label || prev.plain_label,
+    synonyms: next.synonyms.length >= prev.synonyms.length ? next.synonyms : prev.synonyms,
+    xrefs: { OMIM: next.xrefs.OMIM || prev.xrefs.OMIM || "" },
+    cluster: (next.cluster && next.cluster !== "unmapped" ? next.cluster : prev.cluster) ?? "unmapped",
+    research_activity: next.research_activity || prev.research_activity,
+    attributes: {
+      gene: next.attributes.gene || prev.attributes.gene || "",
+      description: next.attributes.description || prev.attributes.description || "",
+      patient_group: next.attributes.patient_group || prev.attributes.patient_group || "",
+    },
+  };
+}
+
+function remember(disease: Disease, groupLabel?: string | null) {
+  upsert(diseases, disease, mergeDisease);
+  const stored = diseases.find((d) => d.id === disease.id);
+  const clusterId = stored?.cluster;
+  if (clusterId && !clusters.some((c) => c.id === clusterId)) clusters.push(toUiCluster(clusterId, groupLabel));
+  return stored ?? disease;
+}
+
+const journeys = new Map<string, Promise<ApiJourneyResponse>>();
+const subgraphs = new Map<string, Promise<ApiSubgraphResponse | null>>();
+const graphs = new Map<string, Promise<{ nodes: Disease[]; edges: Edge[] }>>();
+
+function cached<T>(map: Map<string, Promise<T>>, key: string, load: () => Promise<T>): Promise<T> {
+  let p = map.get(key);
+  if (!p) {
+    p = load();
+    map.set(key, p);
+    p.catch(() => map.delete(key));
+  }
+  return p;
+}
+
+const loadJourney = (id: string) => cached(journeys, id, () => USE_RECOMMEND ? atlasApi.recommend(id) : atlasApi.journey(id));
+// The subgraph enriches (research activity, evidence types, partner sources) but is not required.
+const loadSubgraph = (id: string) => cached(subgraphs, id, () => atlasApi.subgraph(id, { focus: "all" }).catch((err: unknown) => { warn("subgraph", err); return null; }));
+
+async function loadDisease(id: string) {
+  const [journey, subgraph] = await Promise.all([loadJourney(id), loadSubgraph(id)]);
+  const node = subgraph?.nodes.find((n) => n.id === id) ?? null;
+  const disease = remember(toUiDisease({ node, journey, subgraph }), node?.attrs.group ?? null);
+  return { disease, journey, subgraph };
+}
+
+function warn(where: string, err: unknown) {
+  console.warn(`[atlas api] ${where}:`, err instanceof Error ? err.message : err);
+}
+
+function geneFor(subgraph: ApiSubgraphResponse | null, diseaseId: string) {
+  if (!subgraph) return "";
+  const geneEdge = subgraph.edges.find((e) => e.source === diseaseId && e.relation === "caused_by");
+  return geneEdge ? subgraph.nodes.find((n) => n.id === geneEdge.target)?.name ?? "" : "";
+}
+
+const api = {
+  async searchEntities(query: string): Promise<Disease[]> {
+    const q = query.trim();
+    if (!q) return [];
+    try {
+      const res = await atlasApi.search(q);
+      const hits = res.matches.filter((m) => m.type === "disease").slice(0, 10);
+      const nodesById = await Promise.all(hits.map((m) => atlasApi.node(m.id).catch(() => null)));
+      return hits.map((m, i) => {
+        const node = nodesById[i] ?? null;
+        return remember(searchMatchToUiDisease(m, node), node?.attrs.group ?? null);
+      });
+    } catch (err) { warn("search", err); return []; }
+  },
+
+  async getDiseaseProfile(id: string): Promise<Disease | null> {
+    try { return (await loadDisease(id)).disease; }
+    catch (err) { if (!(err instanceof AtlasApiError && err.isNotFound)) warn("profile", err); return null; }
+  },
+
+  async getPatientGroups(id: string): Promise<string> {
+    try {
+      const journey = await loadJourney(id);
+      return journey.organizations.filter((o) => o.for_disease === id && o.kind === "patient_group").map((o) => o.name).join(", ");
+    } catch (err) { warn("patient groups", err); return ""; }
+  },
+
+  getGraph(focusId: string): Promise<{ nodes: Disease[]; edges: Edge[] }> {
+    return cached(graphs, focusId, async () => {
+      try {
+        const { disease, journey, subgraph } = await loadDisease(focusId);
+        const simEdges = toUiSimilarEdges(journey, subgraph);
+        const neighbours: Disease[] = [];
+        for (const e of simEdges) {
+          const sim = [...journey.similar, ...journey.lookalikes].find((s) => s.id === e.target);
+          const node = subgraph?.nodes.find((n) => n.id === e.target) ?? null;
+          const d = toUiDisease({ node, gene: geneFor(subgraph, e.target), fallback: { id: e.target, name: sim?.name ?? e.target, short: sim?.name ?? null } });
+          neighbours.push(remember(d, node?.attrs.group ?? null));
+          upsert(allEdges, e);
+        }
+        return { nodes: [disease, ...neighbours], edges: simEdges };
+      } catch (err) {
+        if (!(err instanceof AtlasApiError && err.isNotFound)) warn("graph", err);
+        throw err;
+      }
+    }).catch(() => ({ nodes: [], edges: [] }));
+  },
+
+  async getPartners(id: string): Promise<Partner[]> {
+    try {
+      const { disease, journey, subgraph } = await loadDisease(id);
+      const edgesById = new Map<string, ApiEdge>((subgraph?.edges ?? []).map((e) => [e.id, e]));
+      const orgs = journey.organizations.filter((o) => o.for_disease === id);
+      // Fetch one cited edge for orgs whose evidence is outside the subgraph (for source links).
+      await Promise.all(orgs.filter((o) => !o.edges.some((e) => edgesById.has(e)) && o.edges[0]).map(async (o) => {
+        const edge = await atlasApi.edge(o.edges[0] as string).catch(() => null);
+        if (edge) edgesById.set(edge.id, edge);
+      }));
+      return orgs.map((o) => toPartner(o, { diseaseName: disease.label, edgesById }));
+    } catch (err) { if (!(err instanceof AtlasApiError && err.isNotFound)) warn("partners", err); return []; }
+  },
+
+  async getEvidence(edgeIds: string[]): Promise<Edge[]> {
+    const out = await Promise.all(edgeIds.map(async (id) => {
+      const local = allEdges.find((e) => e.id === id);
+      if (local) return local;
+      try { return toUiEvidence(await atlasApi.edge(id)); }
+      catch (err) { warn(`edge ${id}`, err); return null; }
+    }));
+    return out.filter((e): e is Edge => Boolean(e));
+  },
+
+  async getSearchCoverage(query: string) {
+    try {
+      const res = await atlasApi.search(query);
+      const hit = res.matches.find((m) => m.type === "disease");
+      if (!hit) return { query, sources: [{ name: "Atlas search", result: `No disease matched (${res.status})` }] };
+      const journey = await loadJourney(hit.id);
+      return {
+        query,
+        sources: [
+          ...journey.searched.map((s) => ({ name: `${s.source} · ${s.query}`, result: s.n_results < 0 ? "Not searched yet" : `${s.n_results} found · ${s.n_kept} kept` })),
+          ...journey.missing.map((m) => ({ name: m.split(":")[0] ?? m, result: m.split(":").slice(1).join(":").trim() || m })),
+        ],
+      };
+    } catch (err) {
+      warn("coverage", err);
+      return { query, sources: [{ name: "Atlas API", result: "Unavailable" }] };
+    }
+  },
+};
