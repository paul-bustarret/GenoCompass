+}
+
+export interface ApiResearcher {
+  id: string;
+  name: string;
+  grants: string[];
+  diseases: string[];
+  edges: string[];
+}
+
+export interface ApiNextStep {
+  kind: "contact" | "join" | "reuse" | "build";
+  step: string;
+  text: string;
+  from_disease: string;
+  target_id: string | null;
+  edges: string[];
+}
+
+export interface ApiCard {
+  key: "whats_going_on" | "similar" | "what_exists" | "next_step" | string;
+  title: string;
+  text: string;
+  citations: string[];
+  status: "ok" | "no_supported_evidence";
+}
+
+export interface ApiSearched {
+  source: string;
+  query: string;
+  n_results: number;
+  n_kept: number;
+}
+
+export interface ApiJourneyResponse {
+  status: "ok" | "no_supported_link";
+  disease: { id: string; name: string; short: string | null };
+  user_country: string | null;
+  profile: ApiProfile;
+  similar: ApiSimilar[];
+  lookalikes: ApiSimilar[];
+  organizations: ApiOrganization[];
+  trials: ApiTrial[];
+  assets: ApiAsset[];
+  researchers: ApiResearcher[];
+  next_steps: ApiNextStep[];
+  cards: ApiCard[];
+  searched: ApiSearched[];
+  missing: string[];
+  generated_by: { backend: string; model: string | null; error?: string };
+}
+
+export interface ApiSender {
+  name: string;
+  role: string;
+  context: string;
+}
+
+export interface ApiEmailRequest {
+  org_id?: string | null;
+  disease_id: string;
+  sender: ApiSender;
+}
+
+export interface ApiEmailResponse {
+  org_id: string | null;
+  disease_id: string;
+  to: string | null;
+  recipient_reason: string;
+  subject: string;
+  body: string;
+  citations: string[];
+  warnings: string[];
+  requires_human_review: boolean;
+}
+
+export interface ApiChatMessage {
+  role: "user" | "assistant";
+  content: string;
+}
+
+export interface ApiChatRequest {
+  disease_id: string;
+  messages: ApiChatMessage[];
+}
+
+export interface ApiChatResponse {
+  answer: string;
+  citations: string[];
+  grounded: boolean;
+  out_of_scope: boolean;
+}
+
+export interface ApiDocumentRequest {
+  text?: string | null;
+  url?: string | null;
+  submitted_by?: string;
+  disease_ids?: string[] | null;
+}
+
+export interface ApiDocumentResponse {
+  source_url: string | null;
+  submitted_by: string;
+  added_edges: string[];
+  new_nodes: string[];
+  contradictions: string[];
+  dropped: {
+    quote_check: number;
+    relevance: number;
+    unresolved_entity: number;
+    invalid_type: number;
+    [key: string]: number;
+  };
+  papers_checked: number;
+}
+
+export interface ApiRefreshRequest {
+  since?: string | null;
+  disease_ids?: string[] | null;
+  per_disease?: number;
+}
+
+export interface ApiHealthResponse {
+  status: "ok" | string;
+  nodes: number;
+  edges: number;
+}
+
+// ---------------------------------------------------------------------------
+// Transport
+// ---------------------------------------------------------------------------
+
+export class AtlasApiError extends Error {
+  readonly status: number;
+  readonly path: string;
+  readonly kind: "http" | "timeout" | "network" | "parse";
+  constructor(
+    message: string,
+    opts: { status: number; path: string; kind: AtlasApiError["kind"] },
+  ) {
+    super(message);
+    this.name = "AtlasApiError";
+    this.status = opts.status;
+    this.path = opts.path;
+    this.kind = opts.kind;
+  }
+  get isNotFound() {
+    return this.status === 404;
+  }
+}
+
+type RequestOptions = {
+  method?: "GET" | "POST";
+  body?: unknown;
+  timeoutMs?: number;
+  signal?: AbortSignal;
+};
+
+async function request<T>(path: string, opts: RequestOptions = {}): Promise<T> {
+  const { method = "GET", body, timeoutMs = DEFAULT_TIMEOUT_MS, signal } = opts;
+  const controller = new AbortController();
+  const timer = setTimeout(
+    () => controller.abort(new DOMException("timeout", "TimeoutError")),
+    timeoutMs,
+  );
+  const onAbort = () => controller.abort(signal?.reason);
+  signal?.addEventListener("abort", onAbort, { once: true });
+  let res: Response;
+  try {
+    const init: RequestInit = {
+      method,
+      headers: { Accept: "application/json" },
+      signal: controller.signal,
+    };
+    if (body !== undefined) {
+      init.headers = { Accept: "application/json", "Content-Type": "application/json" };
+      init.body = JSON.stringify(body);
+    }
+    res = await fetch(`${ATLAS_API_URL}${path}`, init);
+  } catch (err) {
+    const timedOut = controller.signal.aborted && !signal?.aborted;
+    throw new AtlasApiError(
+      timedOut
+        ? `Atlas API timed out after ${timeoutMs} ms (${path})`
+        : `Atlas API unreachable at ${ATLAS_API_URL} (${path}): ${err instanceof Error ? err.message : String(err)}`,
+      { status: 0, path, kind: timedOut ? "timeout" : "network" },
+    );
+  } finally {
+    clearTimeout(timer);
+    signal?.removeEventListener("abort", onAbort);
+  }
+  const text = await res.text();
+  let data: unknown = null;
+  if (text) {
+    try {
+      data = JSON.parse(text);
+    } catch {
+      if (res.ok)
+        throw new AtlasApiError(`Atlas API returned non-JSON (${path})`, {
+          status: res.status,
+          path,
+          kind: "parse",
+        });
+    }
+  }
+  if (!res.ok) {
+    const detail =
+      data && typeof data === "object"
+        ? ((data as Record<string, unknown>)["error"] ??
+          (data as Record<string, unknown>)["detail"])
+        : text;
+    throw new AtlasApiError(
+      `Atlas API ${res.status} on ${path}: ${typeof detail === "string" ? detail : JSON.stringify(detail ?? res.statusText)}`,
+      { status: res.status, path, kind: "http" },
+    );
+  }
+  return data as T;
+}
+
+const enc = encodeURIComponent;
+const qs = (params: Record<string, string | number | null | undefined>) => {
+  const p = new URLSearchParams();
+  for (const [k, v] of Object.entries(params))
+    if (v !== undefined && v !== null && v !== "") p.set(k, String(v));
+  const s = p.toString();
+  return s ? `?${s}` : "";
+};
+
+// ---------------------------------------------------------------------------
+// Endpoints
+// ---------------------------------------------------------------------------
+
+export const atlasApi = {
+  /** GET /search?q= */
+  search: (q: string, signal?: AbortSignal) =>
+    request<ApiSearchResponse>(`/search${qs({ q })}`, signal ? { signal } : {}),
+
+  /** GET /subgraph/{id}?focus=&k= */
+  subgraph: (
+    diseaseId: string,
+    opts: { focus?: ApiSubgraphFocus; k?: number; signal?: AbortSignal } = {},
+  ) =>
+    request<ApiSubgraphResponse>(
+      `/subgraph/${enc(diseaseId)}${qs({ focus: opts.focus, k: opts.k })}`,
+      opts.signal ? { signal: opts.signal } : {},
+    ),
+
+  /** GET /journey/{id}?country=  (deterministic, cards: []) */
+  journey: (diseaseId: string, country?: string | null) =>
+    request<ApiJourneyResponse>(`/journey/${enc(diseaseId)}${qs({ country })}`),
+
+  /** GET /recommend/{id}?country=  (journey + LLM cards) */
+  recommend: (diseaseId: string, country?: string | null) =>
+    request<ApiJourneyResponse>(`/recommend/${enc(diseaseId)}${qs({ country })}`, {
+      timeoutMs: LLM_TIMEOUT_MS,
+    }),
+
+  /** POST /email — org_id optional (backend picks the recipient). Never sends. */
+  email: (req: ApiEmailRequest) =>
+    request<ApiEmailResponse>("/email", {
+      method: "POST",
+      body: { org_id: req.org_id ?? null, disease_id: req.disease_id, sender: req.sender },
+      timeoutMs: LLM_TIMEOUT_MS,
+    }),
+
+  /** POST /chat — stateless; send the full history each time. */
+  chat: (req: ApiChatRequest) =>
+    request<ApiChatResponse>("/chat", { method: "POST", body: req, timeoutMs: LLM_TIMEOUT_MS }),
+
+  /** POST /documents */
+  documents: (req: ApiDocumentRequest) =>
+    request<ApiDocumentResponse>("/documents", {
+      method: "POST",
+      body: req,
+      timeoutMs: LLM_TIMEOUT_MS,
+    }),
+
+  /** POST /refresh */
+  refresh: (req: ApiRefreshRequest = {}) =>
+    request<ApiDocumentResponse>("/refresh", {
+      method: "POST",
+      body: req,
+      timeoutMs: LLM_TIMEOUT_MS * 3,
+    }),
+
+  /** GET /edge/{edge_id} */
+  edge: (edgeId: string) => request<ApiEdge>(`/edge/${enc(edgeId)}`),
+
+  /** GET /node/{node_id} */
+  node: (nodeId: string) => request<ApiNode>(`/node/${enc(nodeId)}`),
+
+  /** GET /health */
+  health: () => request<ApiHealthResponse>("/health", { timeoutMs: 5_000 }),
+};
+
+export type AtlasApi = typeof atlasApi;
